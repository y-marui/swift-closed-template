# iOS deploy target device UDID
# Find yours: xcrun xctrace list devices
# Then: make ios
# IOS_DEVICE_UDID=

# DMG build settings
# Set to true to build and copy DMG after deploy / deploy-release
DEPLOY_DMG=false
# Destination directory to copy the DMG: the Swift folder inside the iCloud Drive Build folder,
# which `install-my-apps` reads (Tauri apps use Build/Tauri).
# DMG_DEST=~/Library/Mobile Documents/com~apple~CloudDocs/Build/Swift

# Where `make deploy` installs the app (default: /Applications/My Swift).
# Use /Applications to install directly under it.
# DEPLOY_DIR=/Applications/My Swift
