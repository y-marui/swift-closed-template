# iOS deploy target device UDID
# Find yours: xcrun xctrace list devices
# Then: make ios
# IOS_DEVICE_UDID=

# DMG build settings
# Set to true to build and copy DMG after deploy / deploy-release
DEPLOY_DMG=false
# Destination directory to copy the DMG (e.g. iCloud Drive folder)
# DMG_DEST=~/Library/Mobile Documents/com~apple~CloudDocs/Build

# Code signing (required for make dmg)
# Your Apple Developer Team ID: https://developer.apple.com/account
# TEAM_ID=
# Your full Developer ID name as registered in Apple Developer Program
# DEVELOPER_NAME=Your Name
